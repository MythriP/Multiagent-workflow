# ─── Script Agent Environment ────────────────────────────────────────────────
# Copy this file to `.env` and fill in the blanks. Never commit the real `.env`.

# LLM execution mode:
CLAUDE_MODE=api

# Anthropic (Claude) — required only when CLAUDE_MODE=api
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ElevenLabs — get from elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Claude models — can swap to claude-opus-4-5 for higher quality
NARRATIVE_MODEL=claude-sonnet-4-5
SCENE_WRITER_MODEL=claude-sonnet-4-5

# Path to the Remotion project that owns the rendering composition.
# Relative to script_agent/ (or use an absolute path).
REMOTION_DEV_PATH=../remotion_dev

# Path to the sourcing agent outputs root (for --watch mode)
SOURCING_OUTPUTS_PATH=../sourcing_agent/outputs

# Max video download duration in seconds (videos longer than this = thumbnail only)
MAX_VIDEO_DOWNLOAD_SEC=500

# Set to "true" to skip ElevenLabs voiceover (renders silently — good for demo/testing).
# Keep this `true` while iterating on visuals so we don't burn voice credits on
# rejected drafts. Flip to `false` only when the visuals are signed off.
SKIP_VOICEOVER=false

# ─── Lip-sync (talking avatar) ──────────────────────────────────────────────
# Set to "true" to skip fal.ai lipsync (renders with the still avatar).
# Useful for visual iteration so we don't burn fal.ai credits.
SKIP_LIPSYNC=false

# fal.ai talking-head model. Default = ByteDance OmniHuman v1 — image+audio
# SOTA with full head sway, blinks, and natural expression from a single
# still photo. $0.14 per second of audio, audio capped at 30s per call so
# the pipeline auto-chunks longer narratives into 28s slices.
#
# Alternatives:
#   • fal-ai/bytedance/omnihuman/v1.5  — newer, prompt-aware (~$0.16/s)
#   • fal-ai/echomimic-v3              — Alibaba EchoMimic V3 ($0.20/s)
#   • fal-ai/sync-lipsync              — Sync Labs lip-only ($0.012/s, no head motion)
#   • fal-ai/latentsync                — cheapest, lip-only ($0.005/s, no head motion)
FAL_LIPSYNC_MODEL=fal-ai/bytedance/omnihuman

# ─── Stock + generative media providers ─────────────────────────────────────
# Pexels (stills + 9:16 videos). Free tier: 200 req/hr, 20K req/month.
# Get a key: https://www.pexels.com/api/new/
PEXELS_API_KEY=

# fal.ai (FLUX schnell for image generation). FALLBACK ONLY — used when
# Pexels has nothing relevant. ~$0.025/image. Leave empty to disable.
# Get a key: https://fal.ai/dashboard/keys
FAL_KEY=

SKIP_VIDEO_GEN=false
MAX_VIDEO_GEN_REQUESTS=4
VIDEO_GEN_MAX_DURATION_SEC=6.0
VIDEO_GEN_MIN_DURATION_SEC=4.0
