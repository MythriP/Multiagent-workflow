# ─── Sourcing Agent Environment ─────────────────────────────────────────────
# Copy this file to `.env` and fill in the blanks. Never commit the real `.env`.

# NewsAPI key — get from https://newsapi.org/account
NEWSAPI_KEY=

# Slack Bot Token (from api.slack.com — create a Slack App, add Bot token scope)
SLACK_BOT_TOKEN=

# Slack Channel ID to post alerts into (e.g. C0123456789)
SLACK_CHANNEL_ID=

# Slack Signing Secret (for verifying button click callbacks)
SLACK_SIGNING_SECRET=

# Port for the Slack interaction callback server (default 3000)
SLACK_CALLBACK_PORT=3000

# Review dashboard URL (used in Slack pings)
DASHBOARD_URL=http://localhost:8000
